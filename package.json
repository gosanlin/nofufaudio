{
  "name": "nofufaudio",
  "version": "1.0.0",
  "description": "nofufaudio Player",
  "author": "ghostzlyy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:web": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development node server.js",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux"
  },
  "build": {
    "appId": "com.nofuf.audio",
    "productName": "NofufAudio",
    "files": [
      "**/*",
      "!*.zip",
      "!node_modules/.cache",
      "!yt-dlp.exe",
      "!yt-dlp"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "logonofufaudio.ico",
      "extraResources": [
        {
          "from": "yt-dlp.exe",
          "to": "yt-dlp.exe"
        },
        {
          "from": "spotify_scraper_helper.py",
          "to": "spotify_scraper_helper.py"
        },
        {
          "from": "spotifypl_to_dl.py",
          "to": "spotifypl_to_dl.py"
        }
      ]
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "icon": "build/icons/logonofufaudio.png",
      "category": "Audio",
      "extraResources": [
        {
          "from": "yt-dlp",
          "to": "yt-dlp"
        },
        {
          "from": "spotify_scraper_helper.py",
          "to": "spotify_scraper_helper.py"
        },
        {
          "from": "spotifypl_to_dl.py",
          "to": "spotifypl_to_dl.py"
        }
      ]
    }
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}
